lint: ## Проверить линтерами код в репозитории
	ruff check ./src

format: ## Запустить автоформатер
	ruff check --fix ./src

list: ## Отобразить список доступных команд и их описание
	@echo "Список доступных команд:"
	@echo "  make lint    - Проверить линтерами код"
	@echo "  make format  - Запустить автоформатер"
	@echo "  make list    - Показать этот список"
	@echo "  make venv    - Создать виртуальное окружение"
	@echo "  make run     - Запустить приложение"
	@echo "  make test    - Запустить тесты"
	@echo "  make clean   - Очистить временные файлы"
