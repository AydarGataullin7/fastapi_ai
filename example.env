# example.env
# Копируйте этот файл в .env и заполните своими значениями

# === DeepSeek API ===
DEEPSEEK_API_KEY=sk-...          # API-ключ для DeepSeek (получить в личном кабинете)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1  # URL API (оставить по умолчанию)
DEEPSEEK_MODEL=deepseek-chat     # Модель DeepSeek (оставить по умолчанию)
DEEPSEEK_MAX_CONNECTIONS=5       # Максимальное количество подключений

# === Unsplash API ===
UNSPLASH_TOKEN=...               # Access Key из Unsplash Developer Dashboard
UNSPLASH_MAX_CONNECTIONS=5       # Максимальное количество подключений
UNSPLASH_TIMEOUT=20              # Таймаут подключения в секундах

# === MinIO (S3-хранилище) ===
MINIO_ENDPOINT=localhost:9000    # Адрес MinIO API (оставить по умолчанию для локальной разработки)
MINIO_ACCESS_KEY=minioadmin      # Логин для доступа к MinIO (обязательно)
MINIO_SECRET_KEY=minioadmin      # Пароль для доступа к MinIO (обязательно)
MINIO_BUCKET=fastai              # Имя бакета (создать в веб-интерфейсе MinIO)
MINIO_SECURE=False               # Использовать HTTPS (True/False)
MINIO_CONNECT_TIMEOUT=5          # Таймаут подключения в секундах
MINIO_READ_TIMEOUT=30            # Таймаут чтения в секундах
MINIO_MAX_CONNECTIONS=10         # Лимит одновременных подключений

# === Gotenberg (генерация скриншотов) ===
GOTENBERG_URL=https://demo.gotenberg.dev  # URL Demo API Gotenberg (обязательно)
GOTENBERG_WIDTH=1024             # Ширина скриншота в пикселях
GOTENBERG_FORMAT=png             # Формат изображения (png/jpeg/webp)
GOTENBERG_WAIT_DELAY=5           # Задержка для анимаций в секундах
GOTENBERG_TIMEOUT=60             # Таймаут запроса в секундах
GOTENBERG_MAX_CONNECTIONS=5      # Лимит одновременных подключений

# === Отладка ===
DEBUG=True                       # Включить режим отладки (True/False)
