# example.env
# Копируйте этот файл в .env и заполните своими значениями

# === DeepSeek API ===
DEEPSEEK_API_KEY=sk-...          # API-ключ для DeepSeek (получить в личном кабинете)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1  # URL API (оставить по умолчанию)
DEEPSEEK_MODEL=deepseek-chat     # Модель DeepSeek (оставить по умолчанию)
DEEPSEEK_MAX_CONNECTIONS=5       # Максимальное количество подключений

# === Unsplash API ===
UNSPLASH_TOKEN=...               # Access Key из Unsplash Developer Dashboard
UNSPLASH_MAX_CONNECTIONS=5       # Максимальное количество подключений
UNSPLASH_TIMEOUT=20              # Таймаут подключения в секундах

# === Отладка ===
DEBUG=True                       # Включить режим отладки (True/False)
